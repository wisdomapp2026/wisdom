{
  "name": "wisdom",
  "version": "1.0.0",
  "private": true,
  "description": "Wisdom - Ingliz tili o'quv platformasi (Admin + Student)",
  "workspaces": [
    "shared",
    "admin-web",
    "student-app"
  ],
  "scripts": {
    "admin:dev": "npm run dev --workspace=admin-web",
    "admin:build": "npm run build --workspace=admin-web",
    "student:web": "npm run dev --workspace=student-app",
    "student:build": "npm run build --workspace=student-app",
    "build": "npm run admin:build && npm run student:build",
    "migrate": "node shared/scripts/migrate.mjs",
    "migrate:finish": "node shared/scripts/migrate-finish.mjs",
    "verify": "node shared/scripts/verify-migration.mjs",
    "check-rls": "node shared/scripts/check-rls.mjs",
    "reset-passwords": "node shared/scripts/reset-passwords.mjs",
    "bot": "node shared/scripts/bot-runner.mjs",
    "bot:webhook": "node shared/scripts/bot-runner.mjs --set-webhook",
    "bot:status": "node shared/scripts/bot-runner.mjs --status"
  }
}
