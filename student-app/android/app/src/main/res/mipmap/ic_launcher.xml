<?xml version="1.0" encoding="utf-8"?>
<!--
  tushunGo ilova ikoni — Android 8 (API 26) dan OLDINGI versiyalar uchun.
  API 26+ esa mipmap-anydpi-v26/ic_launcher.xml dagi <adaptive-icon> ni ishlatadi.
  Bu yerda adaptive-icon ishlatilmaydi, chunki u faqat API 26+ da qo'llanadi.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background"/>
    <item
        android:drawable="@drawable/ic_launcher_foreground"
        android:inset="18%"/>
</layer-list>
